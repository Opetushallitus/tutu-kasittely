{
  "aws": {
    "vpc_cidr": "10.6.64.0/18",
    "availability_zones": 3,
    "domain": "tutu.opintopolku.fi"
  },
  "services": {
    "web_backend": {
      "cpu_limit": "512",
      "memory_limit": "1024",
      "min_count": 1,
      "max_count": 1,
      "allow_ecs_exec": true,
      "env_vars": {
        "LOG_LEVEL": "error",
        "PORT_LISTEN": "8080",
        "HTTP_OPTIONS_TIMEOUT": "5000",
        "HTTP_OPTIONS_RETRY": "2",
        "HTTP_OPTIONS_CLOCK_TOLERANCE": "5",
        "PG_USER": "app",
        "OPINTOPOLKU_DOMAIN": "opintopolku.fi"
      }
    }
  },
  "aurora_databases": {
    "web_backend": {
      "version": "16.11",
      "min_size_acu": 0.5,
      "max_size_acu": 4,
      "performance_insights": true,
      "database_name": "tutu"
    }
  },
  "cloudfront": {
    "require_test_authentication": false
  }
}
